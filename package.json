{
  "name": "armored-flight",
  "version": "1.0.0",
  "private": true,
  "description": "Armored Flight - a browser-based 3D powered-armor flight combat game (Vite + TypeScript + Three.js + Rapier). All 3D assets are generated by Blender Python scripts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/run-blender.mjs tools/blender/build_all.py && node tools/validate-assets.mjs",
    "assets:validate": "node tools/validate-assets.mjs",
    "assets:info": "node tools/run-blender.mjs tools/blender/blender_info.py"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
